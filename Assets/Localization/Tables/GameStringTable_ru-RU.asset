  - m_Id: 8061366365151232
    m_Localized: "\u041F\u0430\u0440\u043E\u043B\u044C \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19420280704819200
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u043A\u043E\u043C\u0430\u043D\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25110850387402752
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25110930544746496
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B,
      \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25110993958428672
    m_Localized: "\u041F\u0443\u043B\u0435\u043C\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25111312176078848
    m_Localized: "\u0421\u0430\u043C\u0430\u044F \u0432\u044B\u0441\u043E\u043A\u0430\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0432\u044B\u0448\u0435
      \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E, \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043D\u0438\u0436\u0435 \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25111516342214656
    m_Localized: "\u041E\u0433\u043D\u0435\u043C\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25111595509702656
    m_Localized: "\u041D\u0438\u0437\u043A\u0430\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C,
      \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0431\u043B\u0438\u0437\u0438, \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25111815442227200
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25111892579672064
    m_Localized: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C,
      \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u0449\u043D\u044B\u043C \u043F\u0440\u043E\u043D\u0437\u0430\u044E\u0449\u0438\u043C
      \u043B\u0430\u0437\u0435\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25112231609458688
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25112355345620992
    m_Localized: "\u0421\u0430\u043C\u0430\u044F \u0432\u044B\u0441\u043E\u043A\u0430\u044F
      \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C, \u043D\u0438\u0437\u043A\u0430\u044F
      \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C, \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u043C\u043E\u0449\u043D\u044B\u043C \u0440\u0430\u0437\u0440\u044B\u0432\u043D\u044B\u043C
      \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25112521951764480
    m_Localized: "\u0414\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 25112608241180672
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C,
      \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u043C\u043E\u0449\u043D\u044B\u043C
      \u0432\u0437\u0440\u044B\u0432\u043E\u043C \u043D\u0430 \u043E\u0447\u0435\u043D\u044C
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25112871437950976
    m_Localized: "\u0414\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 25112929461952512
    m_Localized: "\u041D\u0438\u0437\u043A\u0430\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C, 
      \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0434\u0440\u043E\u043D\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438
      \u0440\u0430\u0437\u0440\u044B\u0432\u043D\u044B\u043C\u0438 \u0441\u043D\u0430\u0440\u044F\u0434\u0430\u043C\u0438"
